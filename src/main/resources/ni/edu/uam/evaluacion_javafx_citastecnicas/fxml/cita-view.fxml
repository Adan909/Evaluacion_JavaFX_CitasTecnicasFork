<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" 
            style="-fx-primary: #1E40AF; -fx-primary-dark: #1E3A8A; -fx-accent: #0EA5E9; -fx-success: #16A34A; -fx-danger: #DC2626; -fx-warning: #D97706; -fx-bg: #F1F5F9; -fx-surface: #FFFFFF; -fx-text: #1E293B; -fx-muted: #64748B; -fx-border: #CBD5E1; -fx-background-color: -fx-bg;" 
            xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="ni.edu.uam.evaluacion_javafx_citastecnicas.controller.CitaController">
   
   <!-- Barra Superior (Header) -->
   <top>
      <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-background-color: -fx-surface; -fx-border-color: -fx-border; -fx-border-width: 0 0 1 0; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 10, 0, 0, 4);" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="16.0" left="24.0" right="24.0" top="16.0" />
         </padding>
         <children>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: -fx-primary;" text="📅 Gestión de Citas Técnicas" />
                        <Label style="-fx-background-color: #E0F2FE; -fx-text-fill: #0369A1; -fx-font-weight: bold; -fx-font-size: 11px; -fx-padding: 3 8; -fx-background-radius: 12px;" text="Módulo Servicios" />
                     </children>
                  </HBox>
                  <Label style="-fx-font-size: 13px; -fx-text-fill: -fx-muted;" text="Programación, asignación de servicios y seguimiento del ciclo de vida de citas técnicas" />
               </children>
            </VBox>
            <Button fx:id="btnVolver" mnemonicParsing="true" onAction="#onVolver" 
                    style="-fx-background-color: -fx-surface; -fx-text-fill: -fx-text; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 16; -fx-background-radius: 6px; -fx-border-color: -fx-border; -fx-border-radius: 6px; -fx-cursor: hand;" 
                    text="← _Volver al Menú">
               <tooltip>
                  <Tooltip text="Regresar a la pantalla principal del sistema" />
               </tooltip>
            </Button>
         </children>
      </HBox>
   </top>

   <!-- Contenido Principal: Formulario a la izquierda y Tabla con Filtros a la derecha -->
   <center>
      <HBox spacing="24.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="16.0" left="24.0" right="24.0" top="16.0" />
         </padding>
         <children>
            <!-- TARJETA FORMULARIO (Izquierda) -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefWidth="400.0" 
                        style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent; -fx-padding: 0;">
               <content>
                  <VBox spacing="14.0" 
                        style="-fx-background-color: -fx-surface; -fx-background-radius: 8px; -fx-border-color: -fx-border; -fx-border-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 10, 0, 0, 4);">
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                     <children>
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: -fx-text;" text="Datos de la Cita Técnica" />

                        <GridPane hgap="12.0" vgap="8.0">
                           <columnConstraints>
                              <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                           </columnConstraints>
                           <children>
                              <!-- Cliente -->
                              <VBox spacing="4.0" GridPane.rowIndex="0">
                                 <children>
                                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: -fx-text;" text="Cliente *" />
                                    <ComboBox fx:id="cmbCliente" maxWidth="Infinity" promptText="Seleccione un cliente" 
                                              style="-fx-background-color: -fx-surface; -fx-border-color: -fx-border; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-font-size: 13px;" />
                                    <Label fx:id="lblErrorCliente" managed="false" style="-fx-text-fill: -fx-danger; -fx-font-size: 11px; -fx-font-weight: bold;" text="Debe seleccionar un cliente" visible="false" />
                                 </children>
                              </VBox>

                              <!-- Fecha -->
                              <VBox spacing="4.0" GridPane.rowIndex="1">
                                 <children>
                                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: -fx-text;" text="Fecha de Atención *" />
                                    <DatePicker fx:id="dpFecha" maxWidth="Infinity" promptText="dd/mm/aaaa" 
                                                style="-fx-background-color: -fx-surface; -fx-border-color: -fx-border; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-font-size: 13px;" />
                                    <Label fx:id="lblErrorFecha" managed="false" style="-fx-text-fill: -fx-danger; -fx-font-size: 11px; -fx-font-weight: bold;" text="Debe seleccionar una fecha válida" visible="false" />
                                 </children>
                              </VBox>

                              <!-- Hora y Minuto -->
                              <VBox spacing="4.0" GridPane.rowIndex="2">
                                 <children>
                                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: -fx-text;" text="Hora de la Cita (24h) *" />
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                       <children>
                                          <VBox alignment="CENTER_LEFT" spacing="2.0" HBox.hgrow="ALWAYS">
                                             <children>
                                                <Spinner fx:id="spnHora" editable="true" maxWidth="Infinity" 
                                                         style="-fx-background-color: -fx-surface; -fx-border-color: -fx-border; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-font-size: 13px;">
                                                   <valueFactory>
                                                      <SpinnerValueFactory.IntegerSpinnerValueFactory amountToStepBy="1" initialValue="8" max="23" min="0" />
                                                   </valueFactory>
                                                </Spinner>
                                                <Label style="-fx-font-size: 10px; -fx-text-fill: -fx-muted;" text="Hora (0-23)" />
                                             </children>
                                          </VBox>
                                          <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: -fx-muted;" text=":" />
                                          <VBox alignment="CENTER_LEFT" spacing="2.0" HBox.hgrow="ALWAYS">
                                             <children>
                                                <Spinner fx:id="spnMinuto" editable="true" maxWidth="Infinity" 
                                                         style="-fx-background-color: -fx-surface; -fx-border-color: -fx-border; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-font-size: 13px;">
                                                   <valueFactory>
                                                      <SpinnerValueFactory.IntegerSpinnerValueFactory amountToStepBy="5" initialValue="0" max="59" min="0" />
                                                   </valueFactory>
                                                </Spinner>
                                                <Label style="-fx-font-size: 10px; -fx-text-fill: -fx-muted;" text="Minuto (paso 5)" />
                                             </children>
                                          </VBox>
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>

                              <!-- Tipo de Servicio -->
                              <VBox spacing="4.0" GridPane.rowIndex="3">
                                 <children>
                                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: -fx-text;" text="Tipo de Servicio *" />
                                    <ComboBox fx:id="cmbTipoServicio" maxWidth="Infinity" promptText="Seleccione tipo de servicio" 
                                              style="-fx-background-color: -fx-surface; -fx-border-color: -fx-border; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-font-size: 13px;">
                                       <items>
                                          <FXCollections fx:factory="observableArrayList">
                                             <String fx:value="Mantenimiento preventivo" />
                                             <String fx:value="Reparación" />
                                             <String fx:value="Instalación de software" />
                                             <String fx:value="Diagnóstico" />
                                          </FXCollections>
                                       </items>
                                    </ComboBox>
                                    <Label fx:id="lblErrorServicio" managed="false" style="-fx-text-fill: -fx-danger; -fx-font-size: 11px; -fx-font-weight: bold;" text="Debe seleccionar un tipo de servicio" visible="false" />
                                 </children>
                              </VBox>

                              <!-- Estado -->
                              <VBox spacing="4.0" GridPane.rowIndex="4">
                                 <children>
                                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: -fx-text;" text="Estado de la Cita *" />
                                    <ComboBox fx:id="cmbEstado" maxWidth="Infinity" promptText="Seleccione estado" 
                                              style="-fx-background-color: -fx-surface; -fx-border-color: -fx-border; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-font-size: 13px;">
                                       <items>
                                          <FXCollections fx:factory="observableArrayList">
                                             <String fx:value="Pendiente" />
                                             <String fx:value="En proceso" />
                                             <String fx:value="Finalizada" />
                                             <String fx:value="Cancelada" />
                                          </FXCollections>
                                       </items>
                                    </ComboBox>
                                    <Label fx:id="lblErrorEstado" managed="false" style="-fx-text-fill: -fx-danger; -fx-font-size: 11px; -fx-font-weight: bold;" text="Debe seleccionar un estado válido" visible="false" />
                                 </children>
                              </VBox>

                              <!-- Descripción -->
                              <VBox spacing="4.0" GridPane.rowIndex="5">
                                 <children>
                                    <HBox alignment="CENTER_LEFT">
                                       <children>
                                          <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: -fx-text;" text="Descripción Técnica *" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="lblContador" style="-fx-font-size: 11px; -fx-text-fill: -fx-muted;" text="0/255" />
                                       </children>
                                    </HBox>
                                    <TextArea fx:id="txtDescripcion" prefRowCount="3" promptText="Detalle el motivo o requerimiento técnico del cliente..." wrapText="true" 
                                              style="-fx-background-color: -fx-surface; -fx-border-color: -fx-border; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-font-size: 13px;" />
                                    <Label fx:id="lblErrorDescripcion" managed="false" style="-fx-text-fill: -fx-danger; -fx-font-size: 11px; -fx-font-weight: bold;" text="La descripción es requerida (máx. 255 caracteres)" visible="false" />
                                 </children>
                              </VBox>
                           </children>
                        </GridPane>

                        <!-- Botones de Acción del Formulario -->
                        <VBox spacing="8.0">
                           <children>
                              <HBox spacing="8.0">
                                 <children>
                                    <Button fx:id="btnGuardar" maxWidth="Infinity" mnemonicParsing="true" onAction="#onGuardar" 
                                            style="-fx-background-color: -fx-success; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 10 16; -fx-background-radius: 6px; -fx-cursor: hand;" 
                                            text="_Guardar" HBox.hgrow="ALWAYS">
                                       <tooltip>
                                          <Tooltip text="Registrar la nueva cita técnica" />
                                       </tooltip>
                                    </Button>
                                    <Button fx:id="btnActualizar" maxWidth="Infinity" mnemonicParsing="true" onAction="#onActualizar" 
                                            style="-fx-background-color: -fx-primary; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 10 16; -fx-background-radius: 6px; -fx-cursor: hand;" 
                                            text="_Actualizar" HBox.hgrow="ALWAYS">
                                       <tooltip>
                                          <Tooltip text="Actualizar los datos de la cita seleccionada" />
                                       </tooltip>
                                    </Button>
                                 </children>
                              </HBox>
                              <HBox spacing="8.0">
                                 <children>
                                    <Button fx:id="btnEliminar" maxWidth="Infinity" mnemonicParsing="true" onAction="#onEliminar" 
                                            style="-fx-background-color: -fx-danger; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 10 16; -fx-background-radius: 6px; -fx-cursor: hand;" 
                                            text="_Eliminar" HBox.hgrow="ALWAYS">
                                       <tooltip>
                                          <Tooltip text="Eliminar la cita técnica seleccionada" />
                                       </tooltip>
                                    </Button>
                                    <Button fx:id="btnLimpiar" maxWidth="Infinity" mnemonicParsing="true" onAction="#onLimpiar" 
                                            style="-fx-background-color: -fx-muted; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 10 16; -fx-background-radius: 6px; -fx-cursor: hand;" 
                                            text="_Limpiar" HBox.hgrow="ALWAYS">
                                       <tooltip>
                                          <Tooltip text="Limpiar formulario y deseleccionar registro" />
                                       </tooltip>
                                    </Button>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </content>
            </ScrollPane>

            <!-- TARJETA TABLA Y FILTROS (Derecha) -->
            <VBox spacing="16.0" 
                  style="-fx-background-color: -fx-surface; -fx-background-radius: 8px; -fx-border-color: -fx-border; -fx-border-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 10, 0, 0, 4);" 
                  HBox.hgrow="ALWAYS">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  <!-- Sección Filtros Separada Visualmente -->
                  <VBox spacing="8.0" style="-fx-background-color: #F8FAFC; -fx-background-radius: 6px; -fx-border-color: -fx-border; -fx-border-radius: 6px; -fx-padding: 12 16;">
                     <children>
                        <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: -fx-primary;" text="🔍 Filtros de Búsqueda de Citas" />
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                           <children>
                              <VBox spacing="2.0">
                                 <children>
                                    <Label style="-fx-font-size: 11px; -fx-text-fill: -fx-muted;" text="Estado:" />
                                    <ComboBox fx:id="cmbFiltroEstado" prefWidth="150.0" promptText="Todos" 
                                              style="-fx-background-color: -fx-surface; -fx-border-color: -fx-border; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-font-size: 12px;">
                                       <items>
                                          <FXCollections fx:factory="observableArrayList">
                                             <String fx:value="Todos" />
                                             <String fx:value="Pendiente" />
                                             <String fx:value="En proceso" />
                                             <String fx:value="Finalizada" />
                                             <String fx:value="Cancelada" />
                                          </FXCollections>
                                       </items>
                                    </ComboBox>
                                 </children>
                              </VBox>
                              <VBox spacing="2.0">
                                 <children>
                                    <Label style="-fx-font-size: 11px; -fx-text-fill: -fx-muted;" text="Fecha:" />
                                    <DatePicker fx:id="dpFiltroFecha" prefWidth="160.0" promptText="dd/mm/aaaa" 
                                                style="-fx-background-color: -fx-surface; -fx-border-color: -fx-border; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-font-size: 12px;" />
                                 </children>
                              </VBox>
                              <Region HBox.hgrow="ALWAYS" />
                              <Button fx:id="btnFiltrar" mnemonicParsing="true" onAction="#onFiltrar" 
                                      style="-fx-background-color: -fx-primary; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 7 16; -fx-background-radius: 6px; -fx-cursor: hand;" 
                                      text="🔍 _Filtrar">
                                 <tooltip>
                                    <Tooltip text="Aplicar criterios de filtrado a la lista de citas" />
                                 </tooltip>
                              </Button>
                              <Button fx:id="btnLimpiarFiltros" mnemonicParsing="true" onAction="#onLimpiarFiltros" 
                                      style="-fx-background-color: -fx-surface; -fx-text-fill: -fx-text; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 7 16; -fx-background-radius: 6px; -fx-border-color: -fx-border; -fx-border-radius: 6px; -fx-cursor: hand;" 
                                      text="✕ Limpiar Filtros">
                                 <tooltip>
                                    <Tooltip text="Restablecer filtros y listar todas las citas" />
                                 </tooltip>
                              </Button>
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- Tabla de Citas -->
                  <TableView fx:id="tblCitas" style="-fx-background-color: -fx-surface; -fx-border-color: -fx-border; -fx-border-radius: 6px; -fx-background-radius: 6px;" VBox.vgrow="ALWAYS">
                     <placeholder>
                        <Label style="-fx-text-fill: -fx-muted; -fx-font-size: 14px; -fx-font-weight: normal;" text="No hay citas registradas" />
                     </placeholder>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <columns>
                        <TableColumn fx:id="colId" minWidth="45.0" prefWidth="55.0" style="-fx-alignment: CENTER;" text="ID" />
                        <TableColumn fx:id="colCliente" minWidth="140.0" prefWidth="170.0" text="Cliente" />
                        <TableColumn fx:id="colFecha" minWidth="95.0" prefWidth="105.0" style="-fx-alignment: CENTER;" text="Fecha" />
                        <TableColumn fx:id="colHora" minWidth="70.0" prefWidth="80.0" style="-fx-alignment: CENTER;" text="Hora" />
                        <TableColumn fx:id="colServicio" minWidth="140.0" prefWidth="160.0" text="Tipo de Servicio" />
                        <TableColumn fx:id="colEstado" minWidth="90.0" prefWidth="110.0" style="-fx-alignment: CENTER;" text="Estado" />
                     </columns>
                  </TableView>
               </children>
            </VBox>
         </children>
      </HBox>
   </center>

   <!-- Pie de Página (Footer con Contador) -->
   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-background-color: -fx-surface; -fx-border-color: -fx-border; -fx-border-width: 1 0 0 0;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="12.0" left="24.0" right="24.0" top="12.0" />
         </padding>
         <children>
            <Label fx:id="lblTotal" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: -fx-primary;" text="Total de citas registradas: 0" />
            <Region HBox.hgrow="ALWAYS" />
            <Label style="-fx-font-size: 12px; -fx-text-fill: -fx-muted;" text="Evaluación Técnica - TecnoAsistencia Nicaragua S.A." />
         </children>
      </HBox>
   </bottom>
</BorderPane>