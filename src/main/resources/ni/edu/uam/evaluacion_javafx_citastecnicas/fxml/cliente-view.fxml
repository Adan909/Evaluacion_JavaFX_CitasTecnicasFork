<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" 
            style="-fx-primary: #1E40AF; -fx-primary-dark: #1E3A8A; -fx-accent: #0EA5E9; -fx-success: #16A34A; -fx-danger: #DC2626; -fx-warning: #D97706; -fx-bg: #F1F5F9; -fx-surface: #FFFFFF; -fx-text: #1E293B; -fx-muted: #64748B; -fx-border: #CBD5E1; -fx-background-color: -fx-bg;" 
            xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="ni.edu.uam.evaluacion_javafx_citastecnicas.controller.ClienteController">
   
   <!-- Barra Superior (Header) -->
   <top>
      <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-background-color: -fx-surface; -fx-border-color: -fx-border; -fx-border-width: 0 0 1 0; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 10, 0, 0, 4);" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="16.0" left="24.0" right="24.0" top="16.0" />
         </padding>
         <children>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: -fx-primary;" text="👥 Gestión de Clientes" />
                        <Label style="-fx-background-color: #EFF6FF; -fx-text-fill: -fx-primary; -fx-font-weight: bold; -fx-font-size: 11px; -fx-padding: 3 8; -fx-background-radius: 12px;" text="Módulo Clientes" />
                     </children>
                  </HBox>
                  <Label style="-fx-font-size: 13px; -fx-text-fill: -fx-muted;" text="Administración, registro y actualización del catálogo de clientes para servicios técnicos" />
               </children>
            </VBox>
            <Button fx:id="btnVolver" mnemonicParsing="true" onAction="#onVolver" 
                    style="-fx-background-color: -fx-surface; -fx-text-fill: -fx-text; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 16; -fx-background-radius: 6px; -fx-border-color: -fx-border; -fx-border-radius: 6px; -fx-cursor: hand;" 
                    text="← _Volver al Menú">
               <tooltip>
                  <Tooltip text="Regresar a la pantalla principal del sistema" />
               </tooltip>
            </Button>
         </children>
      </HBox>
   </top>

   <!-- Contenido Principal: Formulario a la izquierda y Tabla a la derecha -->
   <center>
      <HBox spacing="24.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="16.0" left="24.0" right="24.0" top="16.0" />
         </padding>
         <children>
            <!-- TARJETA FORMULARIO (Izquierda) -->
            <VBox prefWidth="380.0" spacing="16.0" 
                  style="-fx-background-color: -fx-surface; -fx-background-radius: 8px; -fx-border-color: -fx-border; -fx-border-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 10, 0, 0, 4);">
               <padding>
                  <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
               </padding>
               <children>
                  <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: -fx-text;" text="Datos del Cliente" />
                  
                  <GridPane hgap="12.0" vgap="10.0" VBox.vgrow="NEVER">
                     <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                     </columnConstraints>
                     <children>
                        <!-- Nombres -->
                        <VBox spacing="4.0" GridPane.rowIndex="0">
                           <children>
                              <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: -fx-text;" text="Nombres *" />
                              <TextField fx:id="txtNombres" promptText="Ej. Juan Carlos" 
                                         style="-fx-background-color: -fx-surface; -fx-border-color: -fx-border; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 8 12; -fx-font-size: 13px;" />
                              <Label fx:id="lblErrorNombres" managed="false" style="-fx-text-fill: -fx-danger; -fx-font-size: 11px; -fx-font-weight: bold;" text="El nombre es obligatorio (mín. 2 caracteres)" visible="false" />
                           </children>
                        </VBox>

                        <!-- Apellidos -->
                        <VBox spacing="4.0" GridPane.rowIndex="1">
                           <children>
                              <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: -fx-text;" text="Apellidos *" />
                              <TextField fx:id="txtApellidos" promptText="Ej. Pérez Rodríguez" 
                                         style="-fx-background-color: -fx-surface; -fx-border-color: -fx-border; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 8 12; -fx-font-size: 13px;" />
                              <Label fx:id="lblErrorApellidos" managed="false" style="-fx-text-fill: -fx-danger; -fx-font-size: 11px; -fx-font-weight: bold;" text="El apellido es obligatorio (mín. 2 caracteres)" visible="false" />
                           </children>
                        </VBox>

                        <!-- Teléfono -->
                        <VBox spacing="4.0" GridPane.rowIndex="2">
                           <children>
                              <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: -fx-text;" text="Teléfono *" />
                              <TextField fx:id="txtTelefono" promptText="Ej. 8888-8888" 
                                         style="-fx-background-color: -fx-surface; -fx-border-color: -fx-border; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 8 12; -fx-font-size: 13px;" />
                              <Label fx:id="lblErrorTelefono" managed="false" style="-fx-text-fill: -fx-danger; -fx-font-size: 11px; -fx-font-weight: bold;" text="Formato de teléfono no válido (8 dígitos)" visible="false" />
                           </children>
                        </VBox>

                        <!-- Correo Electrónico -->
                        <VBox spacing="4.0" GridPane.rowIndex="3">
                           <children>
                              <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: -fx-text;" text="Correo Electrónico *" />
                              <TextField fx:id="txtCorreo" promptText="Ej. juan.perez@dominio.com" 
                                         style="-fx-background-color: -fx-surface; -fx-border-color: -fx-border; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 8 12; -fx-font-size: 13px;" />
                              <Label fx:id="lblErrorCorreo" managed="false" style="-fx-text-fill: -fx-danger; -fx-font-size: 11px; -fx-font-weight: bold;" text="Formato de correo no válido" visible="false" />
                           </children>
                        </VBox>

                        <!-- Estado Activo -->
                        <HBox alignment="CENTER_LEFT" spacing="8.0" GridPane.rowIndex="4">
                           <padding>
                              <Insets top="4.0" />
                           </padding>
                           <children>
                              <CheckBox fx:id="chkActivo" mnemonicParsing="true" selected="true" 
                                        style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: -fx-text; -fx-cursor: hand;" 
                                        text="Cliente _Activo" />
                           </children>
                        </HBox>
                     </children>
                  </GridPane>

                  <Region VBox.vgrow="ALWAYS" />

                  <!-- Botones de Acción del Formulario -->
                  <VBox spacing="8.0">
                     <children>
                        <HBox spacing="8.0">
                           <children>
                              <Button fx:id="btnGuardar" maxWidth="Infinity" mnemonicParsing="true" onAction="#onGuardar" 
                                      style="-fx-background-color: -fx-success; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 10 16; -fx-background-radius: 6px; -fx-cursor: hand;" 
                                      text="_Guardar" HBox.hgrow="ALWAYS">
                                 <tooltip>
                                    <Tooltip text="Registrar nuevo cliente en la base de datos" />
                                 </tooltip>
                              </Button>
                              <Button fx:id="btnActualizar" maxWidth="Infinity" mnemonicParsing="true" onAction="#onActualizar" 
                                      style="-fx-background-color: -fx-primary; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 10 16; -fx-background-radius: 6px; -fx-cursor: hand;" 
                                      text="_Actualizar" HBox.hgrow="ALWAYS">
                                 <tooltip>
                                    <Tooltip text="Guardar cambios del cliente seleccionado" />
                                 </tooltip>
                              </Button>
                           </children>
                        </HBox>
                        <HBox spacing="8.0">
                           <children>
                              <Button fx:id="btnEliminar" maxWidth="Infinity" mnemonicParsing="true" onAction="#onEliminar" 
                                      style="-fx-background-color: -fx-danger; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 10 16; -fx-background-radius: 6px; -fx-cursor: hand;" 
                                      text="_Eliminar" HBox.hgrow="ALWAYS">
                                 <tooltip>
                                    <Tooltip text="Eliminar cliente seleccionado" />
                                 </tooltip>
                              </Button>
                              <Button fx:id="btnLimpiar" maxWidth="Infinity" mnemonicParsing="true" onAction="#onLimpiar" 
                                      style="-fx-background-color: -fx-muted; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 10 16; -fx-background-radius: 6px; -fx-cursor: hand;" 
                                      text="_Limpiar" HBox.hgrow="ALWAYS">
                                 <tooltip>
                                    <Tooltip text="Limpiar campos del formulario y selección" />
                                 </tooltip>
                              </Button>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>

            <!-- TARJETA TABLA Y BÚSQUEDA (Derecha) -->
            <VBox spacing="16.0" 
                  style="-fx-background-color: -fx-surface; -fx-background-radius: 8px; -fx-border-color: -fx-border; -fx-border-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 10, 0, 0, 4);" 
                  HBox.hgrow="ALWAYS">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  <!-- Barra de Búsqueda -->
                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <children>
                        <TextField fx:id="txtBuscar" promptText="Buscar por nombres, apellidos o correo..." 
                                   style="-fx-background-color: -fx-surface; -fx-border-color: -fx-border; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 8 12; -fx-font-size: 13px;" 
                                   HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnBuscar" mnemonicParsing="true" onAction="#onBuscar" 
                                style="-fx-background-color: -fx-primary; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 16; -fx-background-radius: 6px; -fx-cursor: hand;" 
                                text="🔍 _Buscar">
                           <tooltip>
                              <Tooltip text="Ejecutar búsqueda en el listado de clientes" />
                           </tooltip>
                        </Button>
                        <Button fx:id="btnLimpiarBusqueda" mnemonicParsing="true" onAction="#onLimpiarBusqueda" 
                                style="-fx-background-color: -fx-surface; -fx-text-fill: -fx-text; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 16; -fx-background-radius: 6px; -fx-border-color: -fx-border; -fx-border-radius: 6px; -fx-cursor: hand;" 
                                text="✕ Limpiar">
                           <tooltip>
                              <Tooltip text="Restablecer búsqueda y mostrar todos los registros" />
                           </tooltip>
                        </Button>
                     </children>
                  </HBox>

                  <!-- Tabla de Clientes -->
                  <TableView fx:id="tblClientes" style="-fx-background-color: -fx-surface; -fx-border-color: -fx-border; -fx-border-radius: 6px; -fx-background-radius: 6px;" VBox.vgrow="ALWAYS">
                     <placeholder>
                        <Label style="-fx-text-fill: -fx-muted; -fx-font-size: 14px; -fx-font-weight: normal;" text="No hay clientes registrados" />
                     </placeholder>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <columns>
                        <TableColumn fx:id="colId" minWidth="50.0" prefWidth="60.0" style="-fx-alignment: CENTER;" text="ID" />
                        <TableColumn fx:id="colNombres" minWidth="130.0" prefWidth="160.0" text="Nombres" />
                        <TableColumn fx:id="colApellidos" minWidth="130.0" prefWidth="160.0" text="Apellidos" />
                        <TableColumn fx:id="colTelefono" minWidth="100.0" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Teléfono" />
                        <TableColumn fx:id="colCorreo" minWidth="160.0" prefWidth="200.0" text="Correo Electrónico" />
                        <TableColumn fx:id="colActivo" minWidth="80.0" prefWidth="90.0" style="-fx-alignment: CENTER;" text="Estado" />
                     </columns>
                  </TableView>
               </children>
            </VBox>
         </children>
      </HBox>
   </center>

   <!-- Pie de Página (Footer con Contador) -->
   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-background-color: -fx-surface; -fx-border-color: -fx-border; -fx-border-width: 1 0 0 0;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="12.0" left="24.0" right="24.0" top="12.0" />
         </padding>
         <children>
            <Label fx:id="lblTotal" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: -fx-primary;" text="Total de clientes registrados: 0" />
            <Region HBox.hgrow="ALWAYS" />
            <Label style="-fx-font-size: 12px; -fx-text-fill: -fx-muted;" text="Evaluación Técnica - TecnoAsistencia Nicaragua S.A." />
         </children>
      </HBox>
   </bottom>
</BorderPane>