<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" 
            style="-fx-primary: #1E40AF; -fx-primary-dark: #1E3A8A; -fx-accent: #0EA5E9; -fx-success: #16A34A; -fx-danger: #DC2626; -fx-warning: #D97706; -fx-bg: #F1F5F9; -fx-surface: #FFFFFF; -fx-text: #1E293B; -fx-muted: #64748B; -fx-border: #CBD5E1; -fx-background-color: -fx-bg;" 
            xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="ni.edu.uam.evaluacion_javafx_citastecnicas.controller.MenuController">
   <top>
      <VBox alignment="CENTER" spacing="12.0" style="-fx-background-color: -fx-surface; -fx-border-color: -fx-border; -fx-border-width: 0 0 1 0; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 10, 0, 0, 4);" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="24.0" left="32.0" right="32.0" top="24.0" />
         </padding>
         <children>
            <HBox alignment="CENTER" spacing="16.0">
               <children>
                  <ImageView fitHeight="64.0" fitWidth="64.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../icons/archlogo.png" />
                     </image>
                  </ImageView>
                  <VBox alignment="CENTER_LEFT" spacing="4.0">
                     <children>
                        <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: -fx-primary;" text="TecnoAsistencia Nicaragua S.A." />
                        <Label style="-fx-font-size: 15px; -fx-text-fill: -fx-muted;" text="Sistema de gestión de citas técnicas y atención a clientes" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <VBox alignment="CENTER" spacing="32.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="32.0" left="48.0" right="48.0" top="32.0" />
         </padding>
         <children>
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: -fx-text;" text="Seleccione un módulo para comenzar" />
            <HBox alignment="CENTER" spacing="40.0">
               <children>
                  <!-- Tarjeta Clientes -->
                  <Button fx:id="btnClientes" mnemonicParsing="true" onAction="#onIrClientes" prefHeight="260.0" prefWidth="380.0" 
                          style="-fx-background-color: -fx-surface; -fx-background-radius: 12px; -fx-border-color: -fx-border; -fx-border-radius: 12px; -fx-border-width: 1.5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 16, 0, 0, 6); -fx-cursor: hand; -fx-alignment: center;">
                     <graphic>
                        <VBox alignment="CENTER" spacing="16.0">
                           <padding>
                              <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                           </padding>
                           <children>
                              <Label style="-fx-font-size: 52px; -fx-text-fill: -fx-primary;" text="👥" />
                              <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: -fx-primary;" text="Gestión de Clientes" />
                              <Label alignment="CENTER" maxWidth="300.0" style="-fx-font-size: 13px; -fx-text-fill: -fx-muted; -fx-alignment: center;" text="Registro, actualización, consulta y administración de información de clientes" textAlignment="CENTER" wrapText="true" />
                              <Label style="-fx-background-color: #EFF6FF; -fx-text-fill: -fx-primary; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 6 16; -fx-background-radius: 20px;" text="Acceder al módulo →" />
                           </children>
                        </VBox>
                     </graphic>
                     <tooltip>
                        <Tooltip text="Ir al catálogo y administración de clientes" />
                     </tooltip>
                  </Button>

                  <!-- Tarjeta Citas -->
                  <Button fx:id="btnCitas" mnemonicParsing="true" onAction="#onIrCitas" prefHeight="260.0" prefWidth="380.0" 
                          style="-fx-background-color: -fx-surface; -fx-background-radius: 12px; -fx-border-color: -fx-border; -fx-border-radius: 12px; -fx-border-width: 1.5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 16, 0, 0, 6); -fx-cursor: hand; -fx-alignment: center;">
                     <graphic>
                        <VBox alignment="CENTER" spacing="16.0">
                           <padding>
                              <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                           </padding>
                           <children>
                              <Label style="-fx-font-size: 52px; -fx-text-fill: -fx-accent;" text="📅" />
                              <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: -fx-primary;" text="Gestión de Citas" />
                              <Label alignment="CENTER" maxWidth="300.0" style="-fx-font-size: 13px; -fx-text-fill: -fx-muted; -fx-alignment: center;" text="Programación, asignación de servicios técnicos, seguimiento y control de estados" textAlignment="CENTER" wrapText="true" />
                              <Label style="-fx-background-color: #E0F2FE; -fx-text-fill: #0369A1; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 6 16; -fx-background-radius: 20px;" text="Acceder al módulo →" />
                           </children>
                        </VBox>
                     </graphic>
                     <tooltip>
                        <Tooltip text="Ir a la programación y control de citas técnicas" />
                     </tooltip>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="16.0" style="-fx-background-color: -fx-surface; -fx-border-color: -fx-border; -fx-border-width: 1 0 0 0;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="16.0" left="32.0" right="32.0" top="16.0" />
         </padding>
         <children>
            <Label style="-fx-font-size: 12px; -fx-text-fill: -fx-muted;" text="TecnoAsistencia Nicaragua S.A. © Todos los derechos reservados" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnSalir" mnemonicParsing="true" onAction="#onSalir" 
                    style="-fx-background-color: -fx-danger; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 10 24; -fx-background-radius: 6px; -fx-cursor: hand;" 
                    text="_Salir del Sistema">
               <tooltip>
                  <Tooltip text="Cerrar la aplicación de manera segura" />
               </tooltip>
            </Button>
         </children>
      </HBox>
   </bottom>
</BorderPane>